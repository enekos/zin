{
  "name": "zin-verify",
  "version": "0.2.0",
  "description": "Run Zin specifications as conformance tests in Jest, Vitest, node:test, Mocha and Playwright",
  "license": "MIT",
  "author": "Eneko Sarasola",
  "keywords": [
    "specification",
    "model-checking",
    "conformance",
    "jest",
    "vitest",
    "mocha",
    "playwright"
  ],
  "type": "module",
  "main": "./index.cjs",
  "types": "./index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./index.d.ts",
        "default": "./index.js"
      },
      "require": {
        "types": "./index.d.cts",
        "default": "./index.cjs"
      }
    },
    "./playwright": {
      "import": {
        "types": "./playwright.d.ts",
        "default": "./playwright.js"
      },
      "require": {
        "types": "./playwright.d.cts",
        "default": "./playwright.cjs"
      }
    },
    "./recorder": {
      "import": {
        "types": "./recorder.d.ts",
        "default": "./recorder.js"
      },
      "require": {
        "types": "./recorder.d.cts",
        "default": "./recorder.cjs"
      }
    },
    "./vitest": {
      "types": "./vitest.d.ts",
      "import": "./vitest.js"
    },
    "./vitest-reporter": {
      "types": "./vitest-reporter.d.ts",
      "import": "./vitest-reporter.js"
    }
  },
  "files": [
    "index.js",
    "index.cjs",
    "index.d.ts",
    "index.d.cts",
    "playwright.js",
    "playwright.cjs",
    "playwright.d.ts",
    "playwright.d.cts",
    "recorder.js",
    "recorder.cjs",
    "recorder.d.ts",
    "recorder.d.cts",
    "LICENSE",
    "vitest.js",
    "vitest.d.ts",
    "vitest-reporter.js",
    "vitest-reporter.d.ts"
  ],
  "scripts": {
    "test": "npm run test:node && npm run test:jest && npm run test:jest:esm && npm run test:vitest && npm run test:mocha && npm run test:playwright",
    "test:node": "node --test test/*.test.js",
    "test:jest": "jest --config jest.config.cjs --runInBand",
    "test:jest:esm": "node --experimental-vm-modules node_modules/jest/bin/jest.js --config jest.esm.config.cjs --runInBand",
    "test:vitest": "vitest run --config vitest.config.js",
    "test:mocha": "mocha mocha/*.test.cjs",
    "test:playwright": "playwright test --config playwright.config.cjs && node --test playwright/broken.test.js"
  },
  "engines": {
    "node": ">=18"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/enekos/zin.git",
    "directory": "bindings/js"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "jest": "^30.5.2",
    "mocha": "^12.0.3",
    "vitest": "^5.1.1"
  },
  "peerDependencies": {
    "@playwright/test": ">=1.40",
    "vitest": ">=3"
  },
  "peerDependenciesMeta": {
    "@playwright/test": {
      "optional": true
    },
    "vitest": {
      "optional": true
    }
  }
}
