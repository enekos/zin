system "Recency"

# A two-entry cache that evicts the least recently used key. The list keeps
# keys from least to most recently used: reading a key moves it to the end,
# and adding one to a full cache drops the first.

types
  interchangeable key is one of a, b, c

state
  order is a list of at most 2 key

initially
  order is []

always
  every k in key satisfies number of x in order where x is k <= 1
never
  some k in key satisfies order is [k, k]

sometimes
  length of order is 2

action put(k is a key)
  requires not order has k
  order becomes if length of order < 2 then order with k else rest of order with k

action get(k is a key)
  requires order has k
  order becomes order without k with k

scenario "The least recently used key goes"
  put(a)
  put(b)
  get(a)
  put(c)
  expect order is [a, c]
  reject get(b)
  get(a)
  expect first of order is c and last of order is a
