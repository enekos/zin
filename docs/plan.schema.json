{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/enekos/zin/blob/main/docs/plan.schema.json",
  "title": "Zin test plan (plan/1 and plan/2)",
  "description": "The single definition of the plan file that `zin plan` writes and every runner reads. Keys marked optional are absent from plans written before 0.3; runners must accept both. A plan is plan/2 exactly when some field type is not a scalar or a map of scalars. See docs/plan-format.md for the meaning of each key and the runner contract.",
  "type": "object",
  "required": ["zin", "system", "fingerprint", "cover", "fields", "actions", "states", "parents", "calls", "tests", "summary"],
  "properties": {
    "zin": { "enum": ["plan/1", "plan/2"] },
    "system": { "type": "string" },
    "fingerprint": { "type": "string", "pattern": "^[0-9a-f]{16}$" },
    "sources": {
      "type": "object",
      "additionalProperties": { "type": "string", "pattern": "^[0-9a-f]{16}$" }
    },
    "component": { "type": ["string", "null"] },
    "cover": { "enum": ["transitions", "states", "actions", "scenarios", "pairs"] },
    "max_steps": { "type": "integer", "minimum": 1 },
    "step_budget": { "type": "integer", "minimum": 1 },
    "pair_limit": { "type": ["integer", "null"], "minimum": 1 },
    "observe": {
      "description": "Present only in plans from zin plan --observe: the state fields the adapter's observe is taken to return, in declaration order. The identify tests rule out states that look alike under exactly these fields.",
      "type": "array",
      "items": { "type": "string" }
    },
    "defaults": {
      "description": "The planning options zin plan uses when none are given. Absent from plans written before 0.3.1.",
      "type": "object",
      "required": ["cover", "max_steps", "step_budget", "pair_limit"],
      "properties": {
        "cover": { "enum": ["transitions", "states", "actions", "scenarios", "pairs"] },
        "max_steps": { "type": "integer", "minimum": 1 },
        "step_budget": { "type": "integer", "minimum": 1 },
        "pair_limit": { "type": ["integer", "null"], "minimum": 1 }
      }
    },
    "fields": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "type"],
        "properties": {
          "name": { "type": "string" },
          "type": { "$ref": "#/$defs/fieldType" }
        }
      }
    },
    "actions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "params"],
        "properties": {
          "name": { "type": "string" },
          "params": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["name", "type"],
              "properties": {
                "name": { "type": "string" },
                "type": { "$ref": "#/$defs/domain" }
              }
            }
          }
        }
      }
    },
    "states": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "object" }
    },
    "parents": {
      "type": "array",
      "items": {
        "type": ["array", "null"],
        "minItems": 2,
        "maxItems": 2,
        "items": { "type": "integer", "minimum": 0 }
      }
    },
    "calls": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["action", "args", "text"],
        "properties": {
          "action": { "type": "string" },
          "args": { "type": "array" },
          "text": { "type": "string" }
        }
      }
    },
    "tests": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "kind", "steps"],
        "properties": {
          "name": { "type": "string" },
          "kind": { "enum": ["scenario", "witness", "tour", "identify"] },
          "steps": {
            "type": "array",
            "items": {
              "type": "array",
              "minItems": 2,
              "maxItems": 2,
              "items": { "type": "integer", "minimum": -1 }
            }
          }
        }
      }
    },
    "summary": {
      "type": "object",
      "required": ["states", "transitions", "tests", "accepted_steps", "rejected_steps"],
      "properties": {
        "states": { "type": "integer", "minimum": 0 },
        "transitions": { "type": "integer", "minimum": 0 },
        "refusals": { "type": "integer", "minimum": 0 },
        "eligible_pairs": { "type": ["integer", "null"], "minimum": 0 },
        "covered_pairs": { "type": ["integer", "null"], "minimum": 0 },
        "tests": { "type": "integer", "minimum": 0 },
        "accepted_steps": { "type": "integer", "minimum": 0 },
        "rejected_steps": { "type": "integer", "minimum": 0 }
      }
    }
  },
  "$defs": {
    "domain": {
      "type": "object",
      "required": ["kind"],
      "properties": {
        "kind": { "enum": ["integer", "boolean", "enum"] },
        "min": { "type": "integer" },
        "max": { "type": "integer" },
        "values": { "type": "array", "items": { "type": "string" } }
      }
    },
    "fieldType": {
      "type": "object",
      "required": ["kind"],
      "properties": {
        "kind": { "enum": ["integer", "boolean", "enum", "map", "record", "optional", "set", "list"] },
        "capacity": { "type": "integer", "minimum": 1 },
        "element": { "$ref": "#/$defs/fieldType" },
        "min": { "type": "integer" },
        "max": { "type": "integer" },
        "values": { "type": "array", "items": { "type": "string" } },
        "keys": { "type": "array", "items": { "type": "string" } },
        "value": { "$ref": "#/$defs/fieldType" },
        "members": {
          "description": "record: the members in declaration order",
          "type": "array",
          "items": {
            "type": "object",
            "required": ["name", "type"],
            "properties": {
              "name": { "type": "string" },
              "type": { "$ref": "#/$defs/fieldType" }
            }
          }
        }
      }
    }
  }
}
